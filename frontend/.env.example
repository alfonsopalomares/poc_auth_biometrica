# Base de la API. Por defecto el dev server de Vite hace proxy de /api al backend
# en http://127.0.0.1:8000 (ver vite.config.js).
VITE_API_BASE_URL=/api

# Backend al que el dev server redirige /api. Útil si corrés uvicorn en otro puerto.
VITE_BACKEND_TARGET=http://127.0.0.1:8000

# Poné true para servir el frontend por HTTPS con los certificados de ssl/.
# Necesario para usar el micrófono desde un dispositivo que no sea localhost.
VITE_USE_HTTPS=false
